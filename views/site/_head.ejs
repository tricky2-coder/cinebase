<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · CineBase</title>
  <meta name="description" content="CineBase – browse movies and series.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css">
</head>
<body class="site">
<header class="s-top" id="s-top">
  <a href="/" class="s-brand">CINEBASE</a>
  <nav class="s-nav">
    <a href="/" class="<%= path === '/' ? 'on' : '' %>">Home</a>
    <% if (tmdbEnabled) { %>
    <a href="/discover?type=movie" class="<%= (path === '/discover' && query.type !== 'tv') || path.startsWith('/m/') ? 'on' : '' %>">Movies</a>
    <a href="/discover?type=tv" class="<%= (path === '/discover' && query.type === 'tv') || path.startsWith('/tv/') ? 'on' : '' %>">Series</a>
    <a href="/browse" class="<%= (path === '/browse' && query.source !== 'plex') || path.startsWith('/t/') ? 'on' : '' %>">My CineBase</a>
    <% } else { %>
    <a href="/browse?type=Movie" class="<%= query && query.type === 'Movie' ? 'on' : '' %>">Movies</a>
    <a href="/browse?type=Series" class="<%= query && query.type === 'Series' ? 'on' : '' %>">Series</a>
    <% } %>
    <% if (plexEnabled) { %><a href="/browse?source=plex" class="<%= query && query.source === 'plex' ? 'on' : '' %>">My Plex</a><% } %>
  </nav>
  <form class="s-search" action="<%= tmdbEnabled ? '/search' : '/browse' %>" method="GET" role="search">
    <input type="search" name="q" value="<%= q %>" placeholder="Search movies & series…" aria-label="Search">
  </form>
  <% if (user && user.role === 'admin') { %><a href="/dashboard" class="s-admin">Dashboard</a><% } %>
  <% if (user) { %>
  <form action="/logout" method="POST" class="s-user">
    <span><%= user.name %></span>
    <button type="submit" class="s-admin">Sign out</button>
  </form>
  <% } %>
</header>
