# Copy this file to .env and fill in your values.
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string

# First-run admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# SQLite database folder
DATA_DIR=./data

# --- Plex (optional) ---
# Address of your Plex Media Server as seen from the machine running CineBase
PLEX_URL=http://192.168.1.50:32400
PLEX_TOKEN=

# --- TMDB (optional) — posters, cast, trailers. Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- OMDb (optional) — used by `npm run import:omdb`. Free key: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# --- Players — VidSrc mirrors (comma-separated, first is the default) plus Vidy (www.vidy.st)
VIDSRC_DOMAINS=vidsrc.pm,vidsrc.cc
# 1 = sandbox the player iframe (blocks popups/redirects; some mirrors won't play)
VIDSRC_SANDBOX=0
# 0 = hide the Vidy player
VIDY=1
