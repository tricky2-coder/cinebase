<!-- Netflix-Style Who's Watching & Profile Management Modal -->
<div class="ww-overlay" id="whos-watching-modal" <%- (typeof standalone !== 'undefined' && standalone) ? '' : 'hidden' %>>
  <div class="ww-container">
    
    <!-- View 1: Who's watching? / Manage Profiles -->
    <div class="ww-view" id="ww-view-select">
      <h1 class="ww-main-title" id="ww-select-title">Who's watching?</h1>
      <p class="ww-main-sub" id="ww-select-sub">Each profile keeps its own watchlist, progress and settings.</p>
      
      <div class="ww-grid" id="ww-profiles-grid">
        <!-- Rendered profiles -->
        <% if (typeof userProfiles !== 'undefined' && userProfiles && userProfiles.length) { %>
          <% userProfiles.forEach(function(p) { %>
          <div class="ww-profile-item <%= (typeof activeProfile !== 'undefined' && activeProfile && activeProfile.id === p.id) ? 'active' : '' %>" data-id="<%= p.id %>">
            <div class="ww-avatar-wrap">
              <img src="<%= p.avatar %>" alt="<%= p.name %>">
              <div class="ww-edit-overlay">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                  <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
              </div>
            </div>
            <span class="ww-profile-name"><%= p.name %></span>
          </div>
          <% }); %>
        <% } else if (typeof activeProfile !== 'undefined' && activeProfile) { %>
        <div class="ww-profile-item active" data-id="<%= activeProfile.id %>">
          <div class="ww-avatar-wrap">
            <img src="<%= activeProfile.avatar %>" alt="<%= activeProfile.name %>">
            <div class="ww-edit-overlay">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
              </svg>
            </div>
          </div>
          <span class="ww-profile-name"><%= activeProfile.name %></span>
        </div>
        <% } %>
        <button type="button" class="ww-profile-item ww-add-item" id="btn-ww-add-profile">
          <div class="ww-avatar-wrap ww-add-wrap">
            <span class="ww-add-plus">+</span>
          </div>
          <span class="ww-profile-name">Add Profile</span>
        </button>
      </div>

      <div class="ww-actions">
        <button type="button" class="ww-btn-outline" id="btn-ww-manage">MANAGE PROFILES</button>
        <button type="button" class="ww-btn-outline" id="btn-ww-cancel">CANCEL</button>
      </div>
    </div>

    <!-- View 2: Add Profile / Edit Profile -->
    <div class="ww-view" id="ww-view-form" hidden>
      <div class="ww-form-layout">
        
        <!-- Left Column: Big Avatar Preview & Avatar Name -->
        <div class="ww-form-sidebar">
          <div class="ww-avatar-preview-box">
            <img id="ww-form-preview-img" src="/profiles/avatars/blue-classic-icon.svg" alt="Preview">
          </div>
          <span class="ww-avatar-preview-name" id="ww-form-preview-name">Blue Classic Icon</span>
        </div>

        <!-- Right Column: Profile Form Details -->
        <div class="ww-form-main">
          <h1 class="ww-form-heading" id="ww-form-heading">Add Profile</h1>
          
          <form id="ww-profile-form">
            <input type="hidden" id="ww-edit-id" value="">
            
            <!-- Name Input Field -->
            <div class="ww-field-group">
              <div class="ww-field-label-row">
                <label for="ww-profile-name" class="ww-field-label">Name</label>
                <span class="ww-char-count" id="ww-char-count">0/20</span>
              </div>
              <input type="text" id="ww-profile-name" class="ww-text-input" placeholder="Name" required maxlength="20" autocomplete="off">
            </div>

            <!-- Picture / Avatar Selection Section -->
            <div class="ww-picture-section">
              <label class="ww-field-label">Picture</label>
              
              <!-- Search across all avatars -->
              <div class="ww-avatar-search-box">
                <input type="text" id="ww-avatar-search-input" class="ww-avatar-search-input" placeholder="Search characters and titles across all avatars" autocomplete="off">
                <svg class="ww-search-icon" width="16" height="16" fill="none" stroke="#737373" stroke-width="2" viewBox="0 0 24 24">
                  <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </div>

              <!-- Category Title -->
              <div class="ww-category-title">Classics</div>

              <!-- Grid of 23 Avatar Presets -->
              <div class="ww-avatar-grid" id="ww-avatar-grid">
                <!-- Dynamically populated from presets with active selection border -->
              </div>
            </div>

            <!-- Toggles Section -->
            <div class="ww-toggles-section">
              <div class="ww-divider"></div>
              
              <!-- Kids Profile Toggle -->
              <div class="ww-toggle-row">
                <div class="ww-toggle-info">
                  <div class="ww-toggle-title">Kids profile</div>
                  <div class="ww-toggle-sub">Give an adult profile a PIN first; it is what stops a child switching out.</div>
                </div>
                <label class="ww-switch">
                  <input type="checkbox" id="ww-is-kids">
                  <span class="ww-slider"></span>
                </label>
              </div>

              <!-- Lock with a PIN Toggle -->
              <div class="ww-toggle-row">
                <div class="ww-toggle-info">
                  <div class="ww-toggle-title">Lock with a PIN</div>
                  <div class="ww-toggle-sub">Encrypts this profile's data with AES-256. A forgotten PIN can't be reset, only recovered with the recovery code.</div>
                  <button type="button" class="ww-pin-link" id="btn-ww-pin">Change PIN</button>
                </div>
                <label class="ww-switch">
                  <input type="checkbox" id="ww-lock-pin">
                  <span class="ww-slider"></span>
                </label>
              </div>
            </div>

            <!-- Form Action Buttons -->
            <div class="ww-form-actions">
              <button type="submit" class="ww-btn-save">Save</button>
              <button type="button" class="ww-btn-cancel" id="btn-ww-form-cancel">Cancel</button>
              <button type="button" class="ww-btn-delete" id="btn-ww-delete" hidden>Delete Profile</button>
            </div>
          </form>
        </div>
      </div>
    </div>

  </div>
</div>
<script id="ww-init-data" type="application/json"><%- JSON.stringify({ profiles: (typeof userProfiles !== 'undefined' && userProfiles ? userProfiles : []), activeProfileId: (typeof activeProfile !== 'undefined' && activeProfile ? activeProfile.id : null) }) %></script>
