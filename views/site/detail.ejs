<%- include('_head') %>
<section class="d-hero">
  <div class="d-bg <%= item.backdrop_url ? '' : 'fb' %>" style="<%= item.backdrop_url ? `--img:url('${item.backdrop_url}')` : '' %>; --h:<%= (item.id * 47) % 360 %>"></div>
  <div class="d-wrap">
    <div class="d-poster">
      <% if (item.poster_url) { %>
        <img src="<%= item.poster_url %>" alt="<%= item.title %> poster" fetchpriority="high">
      <% } else { %>
        <div class="poster-fb" style="--h:<%= (item.id * 47) % 360 %>"><span><%= item.title %></span></div>
      <% } %>
    </div>
    <div class="d-info">
      <p class="eyebrow"><%= [item.kind || item.type, item.genre].filter(Boolean).join(' · ') %></p>
      <h1><%= item.title %> <span class="d-year"><%= item.release_year %></span></h1>
      <p class="chips">
        <% if (item.rating != null) { %><span class="chip gold">★ <%= item.rating %></span><% } %>
        <% if (item.language) { %><span class="chip"><%= item.language %></span><% } %>
        <% if (item.type === 'Series' && item.seasons) { %><span class="chip"><%= item.seasons %> season<%= item.seasons > 1 ? 's' : '' %></span><% } %>
        <% if (item.anilist_id && item.type === 'Series' && item.episode_count) { %><span class="chip"><%= item.episode_count %> episode<%= item.episode_count > 1 ? 's' : '' %></span><% } %>
        <% if (item.duration_min) { %><span class="chip"><%= item.type === 'Movie' ? `${Math.floor(item.duration_min / 60)}h ${item.duration_min % 60}m` : `${item.duration_min} min / ep` %></span><% } %>
        <span class="chip"><%= item.status %></span>
        <% if (item.platform) { %><span class="chip"><%= item.platform %></span><% } %>
      </p>
      <div class="cta">
        <% if (typeof animeHref !== 'undefined' && animeHref) { %><a class="sbtn sbtn-play" href="<%= animeHref %>">▶ Watch as anime</a><% } %>
        <% if (player) { %><a class="sbtn <%= typeof animeHref !== 'undefined' && animeHref ? 'sbtn-glass' : 'sbtn-play' %>" href="#watch">▶ Watch</a><% } %>
        <% if (user) { %>
        <button type="button" class="sbtn sbtn-glass btn-watchlist-toggle" id="btn-watchlist-toggle"
          data-media-type="<%= (item.type === 'Movie' ? 'movie' : (item.type === 'Series' && (item.genre === 'Anime' || item.anilist_id) ? 'anime' : 'series')) %>"
          data-media-id="<%= item.id || item.tmdb_id || item.anilist_id %>"
          data-title="<%= item.title %>"
          data-poster="<%= item.poster_url || '' %>"
          data-year="<%= item.release_year || '' %>"
          data-rating="<%= item.rating || '' %>"
          data-href="<%= (item.anilist_id ? `/a/${item.anilist_id}` : (item.type === 'Movie' ? `/m/${item.tmdb_id || item.id}` : `/t/${item.id}`)) %>">
          <svg class="sbtn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
          </svg>
          <span class="btn-watchlist-text">+ Watchlist</span>
        </button>
        <% } %>
        <% if (item.plex_rating_key && plexEnabled) { %><a class="sbtn <%= player ? 'sbtn-glass' : 'sbtn-play' %>" href="/t/<%= item.id %>/plex" target="_blank" rel="noopener">▶ Play on Plex</a><% } %>
        <% if (item.trailer_key) { %><button class="sbtn sbtn-glass" data-trailer="<%= item.trailer_key %>">Trailer</button><% } %>
        <% if (user && user.role === 'admin') { %>
          <% if (!source) { %>
            <a class="sbtn sbtn-glass" href="/titles/<%= item.id %>/edit">Edit</a>
          <% } else if (source.media === 'anime') { %>
          <% } else if (source.localId) { %>
            <a class="sbtn sbtn-glass" href="/titles/<%= source.localId %>">✓ In your CineBase</a>
          <% } else { %>
            <form method="POST" action="/titles/import-tmdb">
              <input type="hidden" name="media" value="<%= source.media %>">
              <input type="hidden" name="id" value="<%= source.tmdbId %>">
              <button class="sbtn sbtn-glass" type="submit">+ Add to CineBase</button>
            </form>
          <% } %>
        <% } %>
      </div>
      <% if (item.synopsis) { %><p class="d-syn"><%= item.synopsis %></p><% } %>
      <dl class="d-facts">
        <% if (item.director) { %><div><dt><%= item.type === 'Series' ? 'Created by' : 'Director' %></dt><dd><%= item.director %></dd></div><% } %>
        <% if (item.cast_members) { %><div><dt>Cast</dt><dd><%= item.cast_members %></dd></div><% } %>
      </dl>
    </div>
  </div>
</section>

<section class="d-sect" id="watch">
  <div class="player-bar">
    <div class="player-title">
      <h2>Watch</h2>
      <% if (player && player.isSeries) { %><span class="now-playing" id="ep-now"><%= player.cfg.anime ? 'Episode 1' : 'Season 1 · Episode 1' %></span><% } %>
    </div>
    <% if (player) { %>
    <div class="player-tools">
      <% if (player.isSeries) { %>
      <div class="player-quick-nav" id="p-quick-nav">
        <button type="button" class="ep-step ep-quick-btn" id="p-quick-prev" title="Previous episode" aria-label="Previous episode">‹</button>
        <select class="ep-quick-select" id="p-quick-select" aria-label="Select episode"></select>
        <button type="button" class="ep-step ep-quick-btn" id="p-quick-next" title="Next episode" aria-label="Next episode">›</button>
        <button type="button" class="ep-step ep-autonext-btn" id="p-autonext" title="Toggle auto-play next episode">Auto-next: ON</button>
      </div>
      <% } %>
      <% if (player.cfg.anime) { %>
      <div class="anime-audio-switch" id="anime-audio" role="group" aria-label="Audio type">
        <button type="button" class="ep-step on" data-audio="sub">Sub</button>
        <button type="button" class="ep-step" data-audio="dub">Dub</button>
      </div>
      <select class="ep-quick-select anime-server-select" id="anime-server" aria-label="Select server">
        <option value="vidy">Vidy (Default)</option>
        <option value="auto">Auto (Best)</option>
        <option value="consumet">Server 1</option>
        <option value="pstream">Server 2</option>
        <option value="anizone">Server 3</option>
        <option value="anikoto">Server 4</option>
        <option value="anipm">Server 5</option>
        <option value="animegg">Server 6</option>
        <option value="animedunya">Server 7</option>
        <option value="aniwaves">Server 8</option>
        <option value="pahenime">Server 9</option>
        <option value="animenosub">Server 10</option>
        <option value="anihq">Server 11</option>
        <option value="reanime">Server 12</option>
      </select>
      <% } else if (player.options && player.options.length > 1) { %>
      <label class="mirror">
        <span>Player</span>
        <select id="p-mirror" class="ep-quick-select" aria-label="Select player">
          <% player.options.forEach(o => { %><option value="<%= o.domain %>"><%= o.label %></option><% }) %>
        </select>
      </label>
      <% } %>
      <button type="button" class="ep-step ep-fs-btn" id="p-fullscreen" title="Full screen">⛶ Fullscreen</button>
      <button type="button" class="ep-step pop-btn" id="p-popout" title="Keep watching in a small always-on-top window">⧉ Pop out</button>
    </div>
    <% } %>
  </div>
  <div class="player" <% if (player) { %>id="player" data-cfg="<%= JSON.stringify(player.cfg) %>"<% } %>>
    <% if (player) { %>
      <% if (player.cfg.anime) { %>
        <div class="anime-artplayer" id="anime-artplayer" hidden></div>
        <div class="anime-player-msg" id="anime-player-msg" hidden></div>
        <iframe
          id="anime-vidy-frame"
          src="<%= player.src %>"
          title="<%= item.title %> player"
          loading="eager"
          fetchpriority="high"
          allow="autoplay *; encrypted-media *; fullscreen *; picture-in-picture *"
          referrerpolicy="no-referrer"
          allowfullscreen></iframe>
        <div class="popped-msg" id="p-popped" hidden>
          <p><b>Playing in the pop-out window</b><span>Close it or bring it back to keep watching here.</span></p>
          <button type="button" class="sbtn sbtn-play" id="p-bringback">⤓ Bring back</button>
        </div>
      <% } else { %>
        <div class="anime-artplayer" id="media-artplayer" hidden></div>
        <div class="anime-player-msg" id="media-player-msg" hidden></div>
        <iframe
          src="<%= player.src %>"
          title="<%= item.title %> player"
          loading="eager"
          fetchpriority="high"
          allow="autoplay *; encrypted-media *; fullscreen *; picture-in-picture *"
          referrerpolicy="no-referrer"
          allowfullscreen></iframe>
        <div class="popped-msg" id="p-popped" hidden>
          <p><b>Playing in the pop-out window</b><span>Close it or bring it back to keep watching here.</span></p>
          <button type="button" class="sbtn sbtn-play" id="p-bringback">⤓ Bring back</button>
        </div>
      <% } %>
    <% } else { %>
      <p class="player-empty">No stream available for this title (it needs an IMDb or TMDB ID).</p>
    <% } %>
  </div>
  <% if (player) { %>
  <div class="backup-pill-row">
    <button type="button" class="backup-pill" id="<%= player.cfg.anime ? 'btn-anime-backup' : 'btn-backup-player' %>">Not playing? Try Backup Player</button>
  </div>
  <% } %>

  <% if (player && player.isSeries) { %>
  <div class="episodes" id="episodes">
    <div class="ep-head">
      <div class="season-tabs" role="tablist" aria-label="Seasons">
        <% player.seasons.forEach(s => { %>
        <button type="button" role="tab" class="season-tab" data-season="<%= s.n %>" aria-selected="<%= s.n === player.seasons[0].n %>"><%= s.name %></button>
        <% }) %>
      </div>
      <div class="ep-nav">
        <% if (player.cfg.anime) { %><label class="ep-jump">Ep <input type="number" id="ep-jump" min="1" value="1" aria-label="Go to episode"></label><% } %>
        <button type="button" class="ep-step" id="ep-prev" aria-label="Previous episode">‹ Prev</button>
        <button type="button" class="ep-step" id="ep-next" aria-label="Next episode">Next ›</button>
      </div>
    </div>
    <div class="ep-list" id="ep-list" aria-live="polite"></div>
  </div>
  <% } %>
</section>

<% if (typeof related !== 'undefined' && related.length) { %>
<section class="row cast-row">
  <div class="row-head"><h2>Seasons &amp; related</h2></div>
  <div class="row-body">
    <button class="arrow l" data-dir="l" aria-label="Scroll left">‹</button>
    <div class="track"><% related.forEach(c => { %><%- include('_card', { c }) %><% }) %></div>
    <button class="arrow r" data-dir="r" aria-label="Scroll right">›</button>
  </div>
</section>
<% } %>

<% if (cast.length) { %>
<section class="row cast-row">
  <div class="row-head"><h2><%= typeof castTitle !== 'undefined' ? castTitle : 'Cast' %></h2></div>
  <div class="row-body">
    <button class="arrow l" data-dir="l" aria-label="Scroll left">‹</button>
    <div class="track cast-track">
      <% cast.forEach(p => { %>
      <div class="cast-card">
        <div class="cast-photo">
          <% if (p.photo) { %><img src="<%= p.photo %>" alt="" loading="lazy"><% } else { %><span><%= p.name.split(' ').map(w => w[0]).slice(0, 2).join('') %></span><% } %>
        </div>
        <b><%= p.name %></b>
        <% if (p.character) { %><small><%= p.character %></small><% } %>
      </div>
      <% }) %>
    </div>
    <button class="arrow r" data-dir="r" aria-label="Scroll right">›</button>
  </div>
</section>
<% } %>

<% if (similar.length) { %>
<div class="rows">
  <section class="row">
    <div class="row-head"><h2>More like this</h2><% if (!source) { %><a href="/browse?genre=<%= encodeURIComponent(item.genre) %>">See all ›</a><% } %></div>
    <div class="row-body">
      <button class="arrow l" data-dir="l" aria-label="Scroll left">‹</button>
      <div class="track"><% similar.forEach(c => { %><%- include('_card', { c }) %><% }) %></div>
      <button class="arrow r" data-dir="r" aria-label="Scroll right">›</button>
    </div>
  </section>
</div>
<% } %>
<%- include('_foot') %>
