<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · CineBase</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<% const isAdmin = user && user.role === 'admin'; %>
<% if (isAdmin) { %>
<header class="topbar">
  <a href="/dashboard" class="brand"><span class="reel">●</span> CINEBASE</a>
  <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle menu">
  <label for="nav-toggle" class="nav-burger"><span></span><span></span><span></span></label>
  <nav class="nav">
    <a href="/dashboard" class="<%= path === '/dashboard' ? 'active' : '' %>">Dashboard</a>
    <a href="/titles" class="<%= path.startsWith('/titles') ? 'active' : '' %>">Movies &amp; Series</a>
    <a href="/users" class="<%= path.startsWith('/users') ? 'active' : '' %>">Users</a>
    <a href="/plex" class="<%= path.startsWith('/plex') ? 'active' : '' %>">Plex</a>
    <a href="/" target="_blank" rel="noopener">View site ↗</a>
    <form action="/logout" method="POST" class="logout">
      <span class="who"><%= user.name %></span>
      <button type="submit" class="btn btn-ghost btn-sm">Logout</button>
    </form>
  </nav>
</header>
<% } %>
<main class="<%= isAdmin ? 'container' : '' %>">
<% if (flash) { %>
  <div class="flash flash-<%= flash.type %>" role="status"><%= flash.msg %></div>
<% } %>
