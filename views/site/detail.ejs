<%- include('_head') %>
<section class="d-hero">
  <div class="d-bg <%= item.backdrop_url ? '' : 'fb' %>" style="<%= item.backdrop_url ? `--img:url('${item.backdrop_url}')` : '' %>; --h:<%= (item.id * 47) % 360 %>"></div>
  <div class="d-wrap">
    <div class="d-poster">
      <% if (item.poster_url) { %>
        <img src="<%= item.poster_url %>" alt="<%= item.title %> poster">
      <% } else { %>
        <div class="poster-fb" style="--h:<%= (item.id * 47) % 360 %>"><span><%= item.title %></span></div>
      <% } %>
    </div>
    <div class="d-info">
      <p class="eyebrow"><%= item.type %> · <%= item.genre %></p>
      <h1><%= item.title %> <span class="d-year"><%= item.release_year %></span></h1>
      <p class="chips">
        <% if (item.rating != null) { %><span class="chip gold">★ <%= item.rating %></span><% } %>
        <% if (item.language) { %><span class="chip"><%= item.language %></span><% } %>
        <% if (item.type === 'Series' && item.seasons) { %><span class="chip"><%= item.seasons %> season<%= item.seasons > 1 ? 's' : '' %></span><% } %>
        <% if (item.duration_min) { %><span class="chip"><%= item.type === 'Movie' ? `${Math.floor(item.duration_min / 60)}h ${item.duration_min % 60}m` : `${item.duration_min} min / ep` %></span><% } %>
        <span class="chip"><%= item.status %></span>
        <% if (item.platform) { %><span class="chip"><%= item.platform %></span><% } %>
      </p>
      <div class="cta">
        <% if (player) { %><a class="sbtn sbtn-play" href="#watch">▶ Watch</a><% } %>
        <% if (item.plex_rating_key && plexEnabled) { %><a class="sbtn <%= player ? 'sbtn-glass' : 'sbtn-play' %>" href="/t/<%= item.id %>/plex" target="_blank" rel="noopener">▶ Play on Plex</a><% } %>
        <% if (item.trailer_key) { %><button class="sbtn sbtn-glass" data-trailer="<%= item.trailer_key %>">Trailer</button><% } %>
      </div>
      <% if (item.synopsis) { %><p class="d-syn"><%= item.synopsis %></p><% } %>
      <dl class="d-facts">
        <% if (item.director) { %><div><dt><%= item.type === 'Series' ? 'Created by' : 'Director' %></dt><dd><%= item.director %></dd></div><% } %>
        <% if (item.cast_members) { %><div><dt>Cast</dt><dd><%= item.cast_members %></dd></div><% } %>
      </dl>
    </div>
  </div>
</section>

<section class="d-sect" id="watch">
  <div class="player-bar">
    <h2>Watch</h2>
    <% if (player) { %>
    <div class="player-ctl">
      <% if (player.isSeries) { %>
      <label>Season <input type="number" id="p-season" value="1" min="1" <%= player.seasons ? `max=${player.seasons}` : '' %>></label>
      <label>Episode <input type="number" id="p-episode" value="1" min="1"></label>
      <% } %>
      <label>Server
        <select id="p-mirror"><% player.domains.forEach(d => { %><option value="<%= d %>"><%= d %></option><% }) %></select>
      </label>
    </div>
    <% } %>
  </div>
  <div class="player" <% if (player) { %>id="player" data-path="<%= player.path %>"<% } %>>
    <% if (player) { %>
      <iframe
        src="<%= player.src %>"
        title="<%= item.title %> player"
        allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
        referrerpolicy="no-referrer"
        <% if (player.sandbox) { %>sandbox="allow-scripts allow-same-origin allow-forms allow-presentation"<% } %>
        allowfullscreen></iframe>
    <% } else { %>
      <p class="player-empty">No stream available for this title (it needs an IMDb or TMDB ID).</p>
    <% } %>
  </div>
</section>

<% if (similar.length) { %>
<div class="rows">
  <section class="row">
    <div class="row-head"><h2>More like this</h2><a href="/browse?genre=<%= encodeURIComponent(item.genre) %>">See all ›</a></div>
    <div class="row-body">
      <button class="arrow l" data-dir="l" aria-label="Scroll left">‹</button>
      <div class="track"><% similar.forEach(c => { %><%- include('_card', { c }) %><% }) %></div>
      <button class="arrow r" data-dir="r" aria-label="Scroll right">›</button>
    </div>
  </section>
</div>
<% } %>
<%- include('_foot') %>
