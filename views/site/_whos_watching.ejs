<!-- Netflix-Style Who's Watching & Profile Management Modal -->
<div class="ww-overlay" id="whos-watching-modal" <%- (typeof showWhosWatching !== 'undefined' && showWhosWatching) ? '' : 'hidden' %>>
  <header class="ww-top-bar">
    <span class="ww-top-brand">CINEBASE</span>
  </header>
  <div class="ww-container">
    
    <!-- View 1: Who's watching? / Manage Profiles -->
    <div class="ww-view" id="ww-view-select">
      <h1 class="ww-main-title" id="ww-select-title">Who's watching?</h1>
      <p class="ww-main-sub" id="ww-select-sub" style="display:none;"></p>
      
      <div class="ww-grid" id="ww-profiles-grid">
        <!-- Rendered profiles -->
        <% if (typeof userProfiles !== 'undefined' && userProfiles && userProfiles.length) { %>
          <% userProfiles.forEach(function(p) { %>
          <div class="ww-profile-item <%= (typeof activeProfile !== 'undefined' && activeProfile && activeProfile.id === p.id) ? 'active' : '' %>" data-id="<%= p.id %>">
            <div class="ww-avatar-wrap">
              <img src="<%= p.avatar %>" alt="<%= p.name %>">
              <% if (typeof activeProfile !== 'undefined' && activeProfile && activeProfile.id === p.id) { %>
                <span class="ww-active-badge">CURRENT</span>
              <% } %>
              <% if (p.is_kids) { %>
                <span class="ww-kids-badge">KIDS</span>
              <% } %>
              <% if (p.has_pin) { %>
                <div class="ww-lock-badge" title="Profile Locked">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                  </svg>
                </div>
              <% } %>
              <div class="ww-edit-overlay">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                  <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
              </div>
            </div>
            <span class="ww-profile-name"><%= p.name %></span>
          </div>
          <% }); %>
        <% } else if (typeof activeProfile !== 'undefined' && activeProfile) { %>
        <div class="ww-profile-item active" data-id="<%= activeProfile.id %>">
          <div class="ww-avatar-wrap">
            <img src="<%= activeProfile.avatar %>" alt="<%= activeProfile.name %>">
            <span class="ww-active-badge">CURRENT</span>
            <% if (activeProfile.is_kids) { %>
              <span class="ww-kids-badge">KIDS</span>
            <% } %>
            <% if (activeProfile.has_pin) { %>
              <div class="ww-lock-badge" title="Profile Locked">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                </svg>
              </div>
            <% } %>
            <div class="ww-edit-overlay">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
              </svg>
            </div>
          </div>
          <span class="ww-profile-name"><%= activeProfile.name %></span>
        </div>
        <% } %>
        <button type="button" class="ww-profile-item ww-add-item" id="btn-ww-add-profile">
          <div class="ww-avatar-wrap ww-add-wrap">
            <span class="ww-add-plus">+</span>
          </div>
          <span class="ww-profile-name">Add Profile</span>
        </button>
      </div>

      <!-- Integrated Center PIN Prompt (seamless floating under hero, NO boxed card) -->
      <div class="ww-pin-prompt" id="ww-pin-prompt" hidden>
        <h2 class="ww-pin-prompt-title">Profile Locked</h2>
        <p class="ww-pin-prompt-sub">Enter your 4-digit PIN.</p>
        <div class="ww-pin-boxes" id="ww-pin-boxes">
          <input type="password" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="ww-pin-digit" data-idx="0" autocomplete="off">
          <input type="password" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="ww-pin-digit" data-idx="1" autocomplete="off">
          <input type="password" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="ww-pin-digit" data-idx="2" autocomplete="off">
          <input type="password" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="ww-pin-digit" data-idx="3" autocomplete="off">
        </div>
        <div class="ww-pin-error" id="ww-pin-error" style="display:none;"></div>
        <div class="ww-pin-actions">
          <button type="button" class="ww-btn-outline" id="btn-ww-pin-cancel">CANCEL</button>
        </div>
      </div>

      <div class="ww-actions" id="ww-main-actions">
        <button type="button" class="ww-btn-outline" id="btn-ww-manage">MANAGE PROFILES</button>
        <button type="button" class="ww-btn-outline" id="btn-ww-cancel" <%- (typeof showWhosWatching !== 'undefined' && showWhosWatching) ? 'style="display:none;"' : '' %>>CANCEL</button>
      </div>
    </div>

    <!-- View 2: Add Profile / Edit Profile -->
    <div class="ww-view" id="ww-view-form" hidden>
      <div class="ww-form-layout">
        
        <!-- Left Column: Big Avatar Preview & Avatar Name -->
        <div class="ww-form-sidebar">
          <div class="ww-avatar-preview-box">
            <img id="ww-form-preview-img" src="/profiles/avatars/blue-classic-icon.svg" alt="Preview">
          </div>
          <span class="ww-avatar-preview-name" id="ww-form-preview-name">Blue Classic Icon</span>
        </div>

        <!-- Right Column: Profile Form Details -->
        <div class="ww-form-main">
          <h1 class="ww-form-heading" id="ww-form-heading">Add Profile</h1>
          
          <form id="ww-profile-form">
            <input type="hidden" id="ww-edit-id" value="">
            
            <!-- Name Input Field -->
            <div class="ww-field-group">
              <div class="ww-field-label-row">
                <label for="ww-profile-name" class="ww-field-label">Name</label>
                <span class="ww-char-count" id="ww-char-count">0/20</span>
              </div>
              <input type="text" id="ww-profile-name" class="ww-text-input" placeholder="Name" required maxlength="20" autocomplete="off">
            </div>

            <!-- Picture / Avatar Selection Section -->
            <div class="ww-picture-section">
              <label class="ww-field-label">Picture</label>
              
              <!-- Search across all avatars -->
              <div class="ww-avatar-search-box">
                <input type="text" id="ww-avatar-search-input" class="ww-avatar-search-input" placeholder="Search characters and titles across all avatars" autocomplete="off">
                <svg class="ww-search-icon" width="16" height="16" fill="none" stroke="#737373" stroke-width="2" viewBox="0 0 24 24">
                  <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </div>

              <!-- Category Title -->
              <div class="ww-category-title">Classics</div>

              <!-- Grid of 23 Avatar Presets -->
              <div class="ww-avatar-grid" id="ww-avatar-grid">
                <!-- Dynamically populated from presets with active selection border -->
              </div>
            </div>

            <!-- Toggles Section -->
            <div class="ww-toggles-section">
              <div class="ww-divider"></div>
              
              <!-- Kids Profile Toggle -->
              <div class="ww-toggle-row">
                <div class="ww-toggle-info">
                  <div class="ww-toggle-title">Kids profile</div>
                  <div class="ww-toggle-sub">Only show titles rated for kids and family.</div>
                  <div class="ww-kids-lock-notice" id="ww-kids-lock-notice" style="display:none; color: #f5b301; font-size: 0.82rem; font-weight: 500; margin-top: 6px;"></div>
                </div>
                <label class="ww-switch">
                  <input type="checkbox" id="ww-is-kids">
                  <span class="ww-slider"></span>
                </label>
              </div>

              <!-- Lock with a PIN Toggle -->
              <div class="ww-toggle-row">
                <div class="ww-toggle-info">
                  <div class="ww-toggle-title">Lock with a PIN</div>
                  <div class="ww-toggle-sub">Require a 4-digit PIN to access this profile.</div>
                  <div class="ww-pin-status-text" id="ww-pin-status-text" style="font-size: 0.82rem; color: #a3a3a3; margin-top: 4px;"></div>
                  
                  <div class="ww-pin-form-group" id="ww-pin-form-group" style="display:none; margin-top: 10px;">
                    <!-- Old PIN field (only when changing or disabling an existing PIN) -->
                    <div id="ww-old-pin-row" style="display:none; margin-bottom: 12px;">
                      <label class="ww-field-label" for="ww-old-pin-input">Current PIN</label>
                      <input type="password" id="ww-old-pin-input" class="ww-text-input ww-pin-input" maxlength="4" placeholder="••••" pattern="\d{4}" inputmode="numeric" autocomplete="current-password">
                    </div>
                    
                    <!-- New PIN field -->
                    <div id="ww-new-pin-row">
                      <label class="ww-field-label" id="ww-pin-input-label" for="ww-pin-input">Enter 4-Digit PIN</label>
                      <input type="password" id="ww-pin-input" class="ww-text-input ww-pin-input" maxlength="4" placeholder="••••" pattern="\d{4}" inputmode="numeric" autocomplete="new-password">
                    </div>

                    <div class="ww-form-error" id="ww-pin-form-error" style="display:none; color: #f87171; font-size: 0.8rem; margin-top: 6px;"></div>
                  </div>
                  
                  <button type="button" class="ww-pin-link" id="btn-ww-pin-change" style="display:none;">Change PIN</button>
                </div>
                <label class="ww-switch">
                  <input type="checkbox" id="ww-lock-pin">
                  <span class="ww-slider"></span>
                </label>
              </div>
            </div>

            <!-- Form Action Buttons -->
            <div class="ww-form-actions">
              <button type="submit" class="ww-btn-save" id="btn-ww-save">Save</button>
              <button type="button" class="ww-btn-cancel" id="btn-ww-form-cancel">Cancel</button>
              <button type="button" class="ww-btn-delete" id="btn-ww-delete" hidden>Delete Profile</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Custom Themed Delete Confirmation Dialog (replacing browser popup) -->
    <div class="ww-dialog-overlay" id="ww-delete-dialog" hidden>
      <div class="ww-dialog-card">
        <div class="ww-dialog-avatar-preview">
          <img id="ww-delete-dialog-avatar" src="" alt="Profile Avatar">
        </div>
        <h3 class="ww-dialog-title" id="ww-delete-dialog-title">Delete Profile?</h3>
        <p class="ww-dialog-text" id="ww-delete-dialog-text">All watch history, watchlist, and personalized recommendations for this profile will be permanently removed.</p>
        <div class="ww-dialog-actions">
          <button type="button" class="ww-btn-cancel" id="btn-ww-delete-cancel">Cancel</button>
          <button type="button" class="ww-btn-danger" id="btn-ww-delete-confirm">Delete Profile</button>
        </div>
      </div>
    </div>

  </div>
</div>
<script id="ww-init-data" type="application/json"><%- JSON.stringify({ profiles: (typeof userProfiles !== 'undefined' && userProfiles ? userProfiles : []), activeProfileId: (typeof activeProfile !== 'undefined' && activeProfile ? activeProfile.id : null) }) %></script>
