<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Movies &amp; Series</h1>
    <p class="muted"><%= total %> record<%= total === 1 ? '' : 's' %> found</p>
  </div>
  <div class="actions">
    <% if (tmdbEnabled) { %>
    <form method="POST" action="/titles/tmdb/enrich" data-confirm="Fetch missing posters, backdrops and trailers from TMDB for all titles?">
      <button class="btn btn-ghost" type="submit">Fetch posters (TMDB)</button>
    </form>
    <% } %>
    <a href="/titles/export.csv?<%= qs %>" class="btn btn-ghost">Export CSV</a>
    <a href="/titles/new" class="btn btn-primary">+ Add Title</a>
  </div>
</div>

<form class="card filters" method="GET" action="/titles">
  <input type="search" name="q" value="<%= query.q || '' %>" placeholder="Search title, director, cast, synopsis…" class="filter-q" aria-label="Search">
  <select name="type" aria-label="Type">
    <option value="">All types</option>
    <% TYPES.forEach(t => { %><option <%= query.type === t ? 'selected' : '' %>><%= t %></option><% }) %>
  </select>
  <select name="genre" aria-label="Genre">
    <option value="">All genres</option>
    <% GENRES.forEach(g => { %><option <%= query.genre === g ? 'selected' : '' %>><%= g %></option><% }) %>
  </select>
  <select name="language" aria-label="Language">
    <option value="">All languages</option>
    <% languages.forEach(l => { %><option <%= query.language === l ? 'selected' : '' %>><%= l %></option><% }) %>
  </select>
  <select name="status" aria-label="Status">
    <option value="">Any status</option>
    <% STATUSES.forEach(s => { %><option <%= query.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
  </select>
  <input type="number" name="year_from" value="<%= query.year_from || '' %>" placeholder="Year from" aria-label="Year from">
  <input type="number" name="year_to" value="<%= query.year_to || '' %>" placeholder="Year to" aria-label="Year to">
  <input type="number" name="min_rating" value="<%= query.min_rating || '' %>" placeholder="Min rating" step="0.1" min="0" max="10" aria-label="Minimum rating">
  <select name="sort" aria-label="Sort">
    <option value="updated" <%= sort === 'updated' ? 'selected' : '' %>>Recently updated</option>
    <option value="title" <%= sort === 'title' ? 'selected' : '' %>>Title A–Z</option>
    <option value="rating" <%= sort === 'rating' ? 'selected' : '' %>>Highest rated</option>
    <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest</option>
    <option value="oldest" <%= sort === 'oldest' ? 'selected' : '' %>>Oldest</option>
  </select>
  <div class="filter-actions">
    <button class="btn btn-primary" type="submit">Search</button>
    <a class="btn btn-ghost" href="/titles">Reset</a>
  </div>
</form>

<div class="table-wrap">
  <table class="table">
    <thead>
      <tr><th>#</th><th>Title</th><th>Type</th><th>Genre</th><th>Language</th><th>Year</th><th>Rating</th><th>Platform</th><th>Status</th><th class="right">Actions</th></tr>
    </thead>
    <tbody>
    <% rows.forEach(t => { %>
      <tr>
        <td data-label="ID"><%= t.id %></td>
        <td data-label="Title" class="title-cell"><% if (t.poster_url) { %><img src="<%= t.poster_url %>" alt="" class="thumb" loading="lazy"><% } %><a href="/titles/<%= t.id %>" class="strong"><%= t.title %></a><% if (t.plex_rating_key) { %> <span class="badge badge-plex">Plex</span><% } %></td>
        <td data-label="Type"><span class="badge badge-<%= t.type.toLowerCase() %>"><%= t.type %></span></td>
        <td data-label="Genre"><%= t.genre %></td>
        <td data-label="Language"><%= t.language %></td>
        <td data-label="Year"><%= t.release_year %></td>
        <td data-label="Rating"><%= t.rating != null ? '★ ' + t.rating : '—' %></td>
        <td data-label="Platform"><%= t.platform || '—' %></td>
        <td data-label="Status"><span class="status status-<%= t.status.toLowerCase() %>"><%= t.status %></span></td>
        <td class="right row-actions">
          <a href="/titles/<%= t.id %>/edit" class="btn btn-ghost btn-sm">Edit</a>
          <form method="POST" action="/titles/<%= t.id %>?_method=DELETE" data-confirm="Delete &quot;<%= t.title %>&quot;?">
            <button class="btn btn-danger btn-sm" type="submit">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
    <% if (!rows.length) { %>
      <tr><td colspan="10" class="empty">No records match your search. <a href="/titles">Clear filters</a></td></tr>
    <% } %>
    </tbody>
  </table>
</div>

<% if (pages > 1) { %>
<nav class="pager" aria-label="Pagination">
  <% if (page > 1) { %><a class="btn btn-ghost btn-sm" href="?<%= qs %>&page=<%= page - 1 %>">‹ Prev</a><% } %>
  <span>Page <%= page %> of <%= pages %></span>
  <% if (page < pages) { %><a class="btn btn-ghost btn-sm" href="?<%= qs %>&page=<%= page + 1 %>">Next ›</a><% } %>
</nav>
<% } %>
<%- include('../partials/footer') %>
